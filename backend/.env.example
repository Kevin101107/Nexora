# ==============================================================================
# Nexora Backend Environment Configuration
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
# In production, unverified mock token fallback is strictly rejected.
ENVIRONMENT=development

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# Frontend URL & CORS Origins
# In production, specify explicit domains (comma-separated).
FRONTEND_URL=http://localhost:3000
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Cryptographic Keys
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_SECONDS=604800

# Demo Mode Toggle
# When true, exposes 1-click evaluation personas at /api/auth/demo-users.
# Set to false for private or production-only instances.
DEMO_MODE_ENABLED=true

# Database Configuration (PostgreSQL / Supabase)
# Leave empty for in-memory development datastore.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
